{
  "manifest_version": 3,
  "name": "Jira to Markdown",
  "version": "1.2.0",
  "description": "Convert Jira tickets to structured Markdown files",
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": ["*://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.atlassian.net/browse/*",
        "*://*.atlassian.net/jira/*",
        "*://*.atlassian.net/software/*",
        "*://*.jira.com/browse/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
